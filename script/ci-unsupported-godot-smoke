#!/usr/bin/env python3
"""Prove that Godot 4.5/4.6 load v4 inertly and mutate no add-on bytes."""

from __future__ import annotations

import argparse
import hashlib
import os
import shutil
import subprocess
import tempfile
from pathlib import Path

REFUSAL = (
    "Godot AI v4 requires Godot 4.7 or newer in the 4.x line; "
    "plugin remains inactive."
)
BRIDGE_REFUSAL = (
    "Godot AI v4 migration requires Godot 4.7 or newer; bridge remains inactive."
)


def tree_digest(root: Path) -> str:
    digest = hashlib.sha256()
    for path in sorted(root.rglob("*"), key=lambda item: item.relative_to(root).as_posix()):
        relative = path.relative_to(root).as_posix().encode()
        digest.update(len(relative).to_bytes(4, "big"))
        digest.update(relative)
        if path.is_symlink():
            kind, payload = b"L", os.readlink(path).encode()
        elif path.is_file():
            kind, payload = b"F", path.read_bytes()
        elif path.is_dir():
            kind, payload = b"D", b""
        else:
            raise AssertionError(f"unsupported add-on entry: {path}")
        digest.update(kind)
        digest.update(len(payload).to_bytes(8, "big"))
        digest.update(payload)
    return digest.hexdigest()


def run_case(godot: Path, source: Path, refusal: str, label: str) -> str:
    with tempfile.TemporaryDirectory(prefix="godot-ai-v4-floor-") as raw_temp:
        temp = Path(raw_temp)
        project = temp / "project"
        addon = project / "addons/godot_ai"
        addon.parent.mkdir(parents=True)
        shutil.copytree(source, addon, symlinks=True)
        project.joinpath("project.godot").write_text(
            f"""[application]
config/name="Godot AI {label} unsupported-floor smoke"
run/main_scene=""

[editor_plugins]
enabled=PackedStringArray("res://addons/godot_ai/plugin.cfg")
""",
            encoding="utf-8",
        )
        project_file_before = project.joinpath("project.godot").read_bytes()
        before = tree_digest(addon)
        log_path = temp / "godot.log"
        capability_dir = temp / "capabilities"
        env = os.environ.copy()
        env.update(
            {
                "GODOT_AI_ALLOW_HEADLESS": "1",
                "GODOT_AI_CAPABILITY_DIR": str(capability_dir),
            }
        )
        command = [
            str(godot),
            "--headless",
            "--editor",
            "--path",
            str(project),
            "--quit-after",
            "3",
            "--log-file",
            str(log_path),
        ]
        completed = subprocess.run(
            command,
            env=env,
            capture_output=True,
            text=True,
            timeout=45,
            check=False,
        )
        output = completed.stdout + completed.stderr
        if log_path.exists():
            output += log_path.read_text(encoding="utf-8", errors="replace")
        if completed.returncode != 0:
            raise AssertionError(
                f"unsupported-engine smoke exited {completed.returncode}:\n{output}"
            )
        if refusal not in output:
            raise AssertionError(f"missing {label} floor refusal:\n{output}")
        if "MCP | plugin loaded" in output:
            raise AssertionError("unsupported engine reached normal plugin startup")
        after = tree_digest(addon)
        if after != before:
            raise AssertionError(f"add-on tree mutated: {before} -> {after}")
        if project.joinpath("project.godot").read_bytes() != project_file_before:
            raise AssertionError("unsupported engine mutated project.godot")
        if capability_dir.exists() and any(capability_dir.iterdir()):
            raise AssertionError("unsupported engine created transport capability state")
    return before


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("godot", type=Path)
    parser.add_argument("--source-root", type=Path, default=Path.cwd())
    args = parser.parse_args()

    godot = args.godot.resolve(strict=True)
    root = args.source_root.resolve(strict=True)
    cases = (
        (root / "plugin/addons/godot_ai", REFUSAL, "v4 runtime"),
        (root / "migration_bridge", BRIDGE_REFUSAL, "v3 bridge"),
    )
    for source, refusal, label in cases:
        digest = run_case(godot, source.resolve(strict=True), refusal, label)
        print(f"PASS: unsupported Godot refused {label} with add-on digest {digest}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
